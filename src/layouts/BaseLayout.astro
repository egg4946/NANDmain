---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** ヒーロー画像がないページではヘッダーを最初から白背景にする */
  solidHeader?: boolean;
}

const siteTitle = "NAND | 南山大学 学生エンジニア団体";
const {
  title,
  description = "NANDは、南山大学で活動する学生エンジニア団体です。プログラミング、Web制作、アプリ開発、ハードウェア、LT会、チーム開発を通して、作る力を育てます。",
  solidHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} | NAND` : siteTitle;
const ogImage = new URL(withBase("assets/head.png"), Astro.site).href;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta
      property="og:description"
      content={title ? description : "南山大学で新しく立ち上がった学生エンジニア団体。初心者も経験者も、作りながら学ぶ場所です。"}
    />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:image" content={ogImage} />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase("assets/rogo.png")} type="image/png" />
  </head>
  <body>
    <Header solid={solidHeader} />
    <slot />
    <Footer />
  </body>
</html>
