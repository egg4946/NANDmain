---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { withBase } from "../lib/url";

interface Props {
  title?: string;
  description?: string;
  /** ヒーローのないページではヘッダーを白背景で固定する */
  solidHeader?: boolean;
}

const siteTitle = "NAND | 南山大学 学生エンジニア団体";
const {
  title,
  description = "NANDは、南山大学で活動する学生エンジニア団体です。プログラミング、Web制作、アプリ開発、ハードウェア、LT会、チーム開発を通して、作る力を育てます。",
  solidHeader = false,
} = Astro.props;

const pageTitle = title ? `${title} | NAND` : siteTitle;
// SNSで共有したときの画像（PR #1 で絶対URLに固定したものを維持）
const ogImage = "http://egghifuazu.me/NANDmain/assets/head.png";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title ?? siteTitle} />
    <meta
      property="og:description"
      content={title ? description : "南山大学で新しく立ち上がった学生エンジニア団体。初心者も経験者も、作りながら学ぶ場所です。"}
    />
    <meta property="og:type" content={title ? "article" : "website"} />
    <meta property="og:image" content={ogImage} />
    <meta name="theme-color" content="#13203a" />
    <title>{pageTitle}</title>
    <link rel="icon" href={withBase("assets/nand-mark.png")} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Lexend:wght@500;600;700&family=Zen+Kaku+Gothic+New:wght@400;500;700;900&display=swap"
    />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <Header solid={solidHeader} />
    <slot />
    <Footer />

    <script>
      // data-reveal の付いた要素を、画面に入ったときにフェードインさせる
      const revealTargets = document.querySelectorAll("[data-reveal]");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -12% 0px", threshold: 0.15 },
        );
        revealTargets.forEach((target) => observer.observe(target));
      } else {
        revealTargets.forEach((target) => target.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
