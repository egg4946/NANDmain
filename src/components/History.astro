---
import { getCollection } from "astro:content";
import { withBase } from "../lib/url";
import { formatDate } from "../lib/date";
import { X_URL } from "../lib/links";

// 記事は src/content/history/ に Markdown で追加する（README 参照）
const entries = (await getCollection("history", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<section class="section history" id="history" aria-labelledby="history-title">
  <div class="container history-layout" data-reveal>
    <h2 class="section-title" id="history-title">過去の活動</h2>
    <div class="history-body">
      {
        entries.length > 0 ? (
          <ol class="history-list">
            {entries.map((entry) => (
              <li>
                <time datetime={entry.data.date.toISOString().slice(0, 10)}>{formatDate(entry.data.date)}</time>
                <a href={withBase(`history/${entry.id}/`)}>
                  <strong>{entry.data.title}</strong>
                </a>
                {entry.data.summary && <p>{entry.data.summary}</p>}
              </li>
            ))}
          </ol>
        ) : (
          <p>
            NANDは立ち上がったばかりの団体です。活動の記録は、実施したものから順にここへ掲載していきます。最新の情報はXをご覧ください。
          </p>
        )
      }
      <a class="text-link" href={X_URL} target="_blank" rel="noreferrer">Xで最新情報を見る</a>
    </div>
  </div>
</section>

<style>
  .history-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .history-list li {
    display: grid;
    gap: 4px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--line);
  }

  .history-list time {
    color: var(--signal);
    font-family: var(--font-en);
    font-size: 14px;
    font-weight: 600;
  }

  .history-list a {
    font-size: 18px;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 5px;
    transition: text-decoration-color 200ms ease;
  }

  .history-list a:hover {
    text-decoration-color: currentColor;
  }

  .history-list p {
    margin: 0;
    color: var(--muted);
  }
</style>
