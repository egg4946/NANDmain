---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { withBase } from "../../lib/url";
import { formatDate } from "../../lib/date";

export async function getStaticPaths() {
  const entries = await getCollection("history", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} solidHeader>
  <main class="article band">
    <a class="back" href={withBase("/#history")}>← 過去の活動へ戻る</a>
    <header>
      <p class="eyebrow">{formatDate(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      {
        entry.data.tags.length > 0 && (
          <ul class="tags">
            {entry.data.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
        )
      }
    </header>
    <div class="prose">
      <Content />
    </div>
  </main>
</BaseLayout>

<style>
  .article {
    max-width: 780px;
    margin: 0 auto;
    padding-top: clamp(120px, 14vw, 168px);
  }

  .back {
    display: inline-block;
    margin-bottom: 28px;
    color: var(--green-dark);
    font-weight: 700;
  }

  h1 {
    font-size: clamp(30px, 5vw, 48px);
    line-height: 1.3;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 2px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    font-size: 13px;
  }

  .prose {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  .prose :global(a) {
    color: var(--green-dark);
    text-decoration: underline;
  }

  .prose :global(img) {
    border-radius: 8px;
  }
</style>
